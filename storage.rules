rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ozone-mall/{folder}/{fileName} {
      // Public can read uploaded images
      allow read: if true;

      // Only authenticated admins can upload or delete
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml|avif)');

      allow delete: if request.auth != null;
    }
  }
}
